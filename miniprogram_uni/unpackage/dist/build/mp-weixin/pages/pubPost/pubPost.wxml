<view class="containor"><view class="publish_text_area"><view class="text_area_title"><input class="title_input" placeholder="请输入标题" maxlength="25" placeholder-style="color:#b3b3b3;font-size:16px;" data-event-opts="{{[['input',[['handleTitleInput',['$event']]]]]}}" value="{{title}}" bindinput="__e"/><view class="{{[titleCount<25?'title_input_counter':'title_input_error_counter']}}">{{titleCount+"/25"}}</view></view><view class="text_area_content"><view class="area_content"><view class="area_content_out"><textarea class="content-textarea" style="height:8rem;" placeholder="请输入正文内容..." maxlength="400" placeholder-style="color:#b3b3b3;font-size:12px;" data-event-opts="{{[['input',[['handleContentInput',['$event']]]]]}}" value="{{content}}" bindinput="__e"></textarea><view class="{{[contentCount<400?'content_textarea_counter':'content_textarea_error_counter']}}">{{contentCount+"/400"}}</view></view></view></view></view><view class="publish_imgs_area"><block wx:for="{{images}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="imgs_area"><view class="iamge_item"><image class="iamge_content" src="{{item}}" data-id="{{index}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewIamge',['$event']]]]]}}" bindtap="__e"></image><image class="iamge_cancel" src="../../static/icons/delete.png" mode="aspectFill" data-id="{{index}}" data-event-opts="{{[['tap',[['deleteImage',['$event']]]]]}}" bindtap="__e"></image></view></view></block><block wx:if="{{images.length<9}}"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="imgs_area" bindtap="__e"><view class="iamge_item"><image class="iamge_content" src="../../static/icons/add.png" mode="aspectFill"></image></view></view></block></view><view class="tag_area"><block wx:for="{{applyList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['sign-setting-border '+(item.isSelect?'selected':'')]}}" data-index="{{index}}" data-event-opts="{{[['tap',[['selectApply',['$event']]]]]}}" bindtap="__e"><text decode="true">{{"#"+item.Item_Name}}</text></view></block></view><view class="btn_all_area"><button class="btn_area" type="primary" open-type="getUserInfo" data-event-opts="{{[['getuserinfo',[['submit',['$event']]]]]}}" bindgetuserinfo="__e">提交</button></view></view>