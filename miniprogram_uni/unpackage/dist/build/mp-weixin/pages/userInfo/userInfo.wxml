<view><view><view class="userinfo"><view data-event-opts="{{[['tap',[['tologin',['$event']]]]]}}" class="userinfo-avatar" bindtap="__e"><open-data type="userAvatarUrl"></open-data></view><view class="nickname"><open-data type="userNickName"></open-data></view></view><view class="expArea"><view class="expBack"></view><image class="expGauge" style="{{('width:'+ExpGaugeRatio+'%;')}}" src="../../static/images/expgauge.jpg"></image><text class="expText">{{"EXP: "+exp+"/"+toNextLvl}}</text></view><view class="list"><view class="wallet"><text>{{"等级\nlv"+level}}</text></view><view class="discount"><text>{{"金币\n"+gold}}</text></view><view class="nut"><text>{{"松果\n"+scoin}}</text></view></view><view class="weui-cells__title">基本信息</view><view class="weui-cells"><view data-event-opts="{{[['tap',[['openPhone',['$event']]]]]}}" class="weui-cell" bindtap="__e"><view class="weui-cell__bd"><view class="_p">手机号码</view></view><view class="weui-cell__ft"><view class="_p">{{phoneData}}</view></view></view><view data-event-opts="{{[['tap',[['openAddress',['$event']]]]]}}" class="weui-cell" bindtap="__e"><view class="weui-cell__bd"><view class="_p">收货地址</view></view><view class="weui-cell__ft"><view class="_p">{{addrData}}</view></view></view></view><view class="weui-cells__title">帖子管理</view><view class="weui-cells"><view data-event-opts="{{[['tap',[['goPostManage',['$event']]]]]}}" class="weui-cell weui-cell_access" bindtap="__e"><view class="weui-cell__bd">我的发帖</view><view class="weui-cell__ft"></view></view><view data-event-opts="{{[['tap',[['gotoAt',['$event']]]]]}}" class="weui-cell weui-cell_access" bindtap="__e"><view class="weui-cell__bd">新的@</view><block wx:if="{{newAts>0&&newAts<=99}}"><view class="identifier1">{{''+newAts+''}}</view></block><block wx:else><block wx:if="{{newAts>99}}"><view class="identifier2">99+</view></block></block><view class="weui-cell__ft"></view></view><block wx:if="{{showMerc}}"><view data-event-opts="{{[['tap',[['goPostMerc',['$event']]]]]}}" class="weui-cell weui-cell_access" bindtap="__e"><view class="weui-cell__bd">商家界面</view><view class="weui-cell__ft"></view></view></block></view></view><view class="popupInput" hidden="{{phoneInputDis}}"><input class="popupInputInput" placeholder="  请输入手机号码" data-event-opts="{{[['input',[['phoneNumInput',['$event']]]]]}}" bindinput="__e"/><button data-event-opts="{{[['tap',[['confirmPhoneNum',['$event']]]]]}}" class="popupInputButton" bindtap="__e">确认</button><view data-event-opts="{{[['tap',[['cancelInput',['$event']]]]]}}" class="popupInputButton2" bindtap="__e">取消</view></view><view class="popupInput" hidden="{{addInputDis}}"><input class="popupInputInput" placeholder="  请输入送货地址" data-event-opts="{{[['input',[['addInput',['$event']]]]]}}" bindinput="__e"/><button data-event-opts="{{[['tap',[['confirmAddress',['$event']]]]]}}" class="popupInputButton" bindtap="__e">确认</button><view data-event-opts="{{[['tap',[['cancelInput',['$event']]]]]}}" class="popupInputButton2" bindtap="__e">取消</view></view><view data-event-opts="{{[['tap',[['signUp',['$event']]]]]}}" class="signupBut" bindtap="__e">每日签到</view><view data-event-opts="{{[['tap',[['refreshPage',['$event']]]]]}}" class="refreshBut" bindtap="__e">刷新</view></view>