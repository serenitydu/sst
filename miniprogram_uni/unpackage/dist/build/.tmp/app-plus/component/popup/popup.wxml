<view class="wx-popup" hidden="{{flag}}"><view class="popup-container"><view class="wx-popup-title">{{title}}</view><view class="wx-popup-con">{{content}}</view><view class="wx-popup-btn"><text data-event-opts="{{[['tap',[['_error',['$event']]]]]}}" class="btn-no" bindtap="__e">{{btn_no}}</text><text data-event-opts="{{[['tap',[['_success',['$event']]]]]}}" class="btn-ok" bindtap="__e">{{btn_ok}}</text></view></view></view>