nditemName',['$event']]]]]}}" bindinput="__e"/><input class="brand" placeholder="输入商品品牌" data-event-opts="{{[['input',[['bindbrand',['$event']]]]]}}" bindinput="__e"/><view data-event-opts="{{[['tap',[['tapSubmig2',['$event']]]]]}}" class="submit1" bindtap="__e">提交</view><view class="clipb1" hidden="{{cpb2}}" data-event-opts="{{[['tap',[['copytoCPB2',['$event']]]]]}}" bindtap="__e">复制ID</view></view><view class="console">{{result2}}</view></swiper-item></swiper>