<view><scroll-view class="container"><block wx:for="{{messages}}" wx:for-item="message" wx:for-index="index" wx:key="index"><block><view class="mssView" data-ind="{{idx}}" data-event-opts="{{[['tap',[['makeRead',['$event']]]]]}}" bindtap="__e"><text style="white-space:pre-wrap;" space="true" decode="true">{{message.content}}</text><text>{{"\nby: "+message.userName+''}}</text><block wx:if="{{message.status=='unread'}}"><image class="newMss" src="https://cdn11.bigcommerce.com/s-hfhomm5/images/stencil/500x659/products/180/451/Solid_Red_Sized__25214.1507754519.jpg?c=2&imbypass=on"></image></block></view></block></block></scroll-view><view class="notificationArea">{{indicator}}</view><view class="inputArea"><input class="input1" placeholder="输入" data-event-opts="{{[['input',[['setInput',['$event']]]]]}}" bindinput="__e"/><button class="but1" open-type="getUserInfo" data-event-opts="{{[['getuserinfo',[['replyTo',['$event']]]]]}}" bindgetuserinfo="__e">提交</button></view><image class="refreshBut" src="https://cdn0.iconfinder.com/data/icons/essentials-solid/100/Refresh-512.png" mode="aspectFill" data-event-opts="{{[['tap',[['refresh',['$event']]]]]}}" bindtap="__e"></image></view>