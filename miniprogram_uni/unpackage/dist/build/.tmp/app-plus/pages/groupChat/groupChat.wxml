<view class="container"><scroll-view class="message_rec" scroll-y="true"><block wx:for="{{msgs}}" wx:for-item="message" wx:for-index="index" wx:key="index"><block><view class="author_cont"><image class="msg_avt" src="{{message.avt}}" mode="aspectFill"></image><text class="author_name">{{message.unm}}</text></view><view class="chatBubble"><view class="blankSpace"></view><text class="msgText">{{message.cnt}}</text><view class="blankSpace2"></view></view></block></block></scroll-view><view class="message_send"><input class="inputArea" name="psw" placeholder="输入评论" data-event-opts="{{[['input',[['setpos',['$event']]]]]}}" value="{{commentInput}}" bindinput="__e"/><button data-event-opts="{{[['tap',[['sendMsg',['$event']]]]]}}" class="confirm_but" bindtap="__e">发送</button></view></view>