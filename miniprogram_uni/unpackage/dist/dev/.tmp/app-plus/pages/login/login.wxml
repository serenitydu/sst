<view class="zai-box"><image class="zai-logo" src="../../static/zaizai-login/login.png" mode="aspectFit"></image><view class="zai-title">{{infoText}}</view><view class="zai-form"><input class="zai-input" placeholder-class placeholder="请输入用户名" data-event-opts="{{[['input',[['__set_model',['','userName','$event',[]]]]]]}}" value="{{userName}}" bindinput="__e"/><input class="zai-input" placeholder-class password placeholder="请输入密码" data-event-opts="{{[['input',[['__set_model',['','userCode','$event',[]]]]]]}}" value="{{userCode}}" bindinput="__e"/><view class="zai-label">忘记密码？</view><button data-event-opts="{{[['tap',[['onClickSignin',['$event']]]]]}}" class="zai-btn" bindtap="__e">立即登录</button><navigator class="zai-label" url="../register/register" hover-class="none">还没有账号？点此注册.</navigator></view></view>