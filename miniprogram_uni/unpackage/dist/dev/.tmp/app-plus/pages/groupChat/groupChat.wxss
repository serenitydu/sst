.container{
	height: 100%;
	width: 100vw;
}
.message_rec{
	height: 86vh;
	width: 100vw;
}
.message_send{
	height: 10vh;
	width: 100vw;
	background: yellow;
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	-webkit-box-orient: horizontal;
	-webkit-box-direction: normal;
	-webkit-flex-direction: row;
	        flex-direction: row;
}
.inputArea{
	width: 100%;
	background: wheat;
	font-size: 200%;
}
.inputWrapper{
	width: 80%;
	height: 100%;
	
	display: -webkit-box;
	
	display: -webkit-flex;
	
	display: flex;
	-webkit-box-orient: vertical;
	-webkit-box-direction: normal;
	-webkit-flex-direction: column;
	        flex-direction: column;
	-webkit-box-pack: center;
	-webkit-justify-content: center;
	        justify-content: center;
	background: #007AFF;
}
.confirm_but{
	width: 20%;
	height: 100%;
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	-webkit-box-orient: vertical;
	-webkit-box-direction: normal;
	-webkit-flex-direction: column;
	        flex-direction: column;
	-webkit-box-pack: center;
	-webkit-justify-content: center;
	        justify-content: center;
	-webkit-box-align: center;
	-webkit-align-items: center;
	        align-items: center;
	font-size: 150%;
	background: goldenrod;
}
.chatBubble{
	width: 50%;
	position: relative;
	left:5vw;
}
.msgText{
	display: -webkit-box;
	text-overflow: ellipsis; 
	word-wrap: break-word; 
	white-space: normal !important;
	-webkit-box-orient: vertical;
	background: goldenrod;
	border-radius: 15rpx;
}
.blankSpace{
	height: 2vh;
}
.blankSpace2{
	height: 2vh;
}
.msg_avt{
	height: 10vw;
	width: 10vw;
	
	border-radius: 100%;
}
.author_cont{
	position: relative;
	left: 5vw;
	top:2vw;
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	-webkit-box-orient: horizontal;
	-webkit-box-direction: normal;
	-webkit-flex-direction: row;
	        flex-direction: row;
	-webkit-box-pack: start;
	-webkit-justify-content: flex-start;
	        justify-content: flex-start;
}
.author_name{
	position: relative;
	left: 3vw;
	font-size: 120%;
	font-weight: 700;
	color: #94AFCE;
}

