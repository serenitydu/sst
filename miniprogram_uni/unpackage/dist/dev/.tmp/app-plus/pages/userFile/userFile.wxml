<view class="bkg"><view class="avtSpace"><image class="avtImg" src="{{avtUrl}}" mode="aspectFill" data-event-opts="{{[['tap',[['uploadImg',['$event']]]]]}}" bindtap="__e"></image></view><view data-event-opts="{{[['tap',[['openInputBlock',['$event']]]]]}}" class="nameSpace" bindtap="__e">{{userName}}</view><view class="blankSpace">点击以更改头像/昵称</view><block wx:if="{{enabledBlock}}"><view class="changeNameBlock"><input class="inputBlock" maxlength="20" placeholder="请输入新用户名..." clearable="true" data-event-opts="{{[['input',[['inputed',['$event']]]]]}}" bindinput="__e"/><view class="confirmBtBlock"><view data-event-opts="{{[['tap',[['submitUserName',['$event']]]]]}}" class="confirmBt" bindtap="__e">确认</view><view data-event-opts="{{[['tap',[['disableBlock',['$event']]]]]}}" class="confirmBt" bindtap="__e">取消</view></view></view></block></view>