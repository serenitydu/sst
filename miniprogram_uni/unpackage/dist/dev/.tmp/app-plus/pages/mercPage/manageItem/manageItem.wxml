<view><view style="{{('width: '+imgwd+'; height: '+imght+'px;')}}"><image style="width:100%;height:100%;" src="{{coll.img}}" mode="aspectFill" data-event-opts="{{[['tap',[['openImg',['$event']]]]]}}" bindtap="__e"></image></view><view style="{{('width: '+imgwd+'; height: '+botht+'px;')}}"><input data-event-opts="{{[['input',[['updateTitle',['$event']]]]]}}" class="title" value="{{newTitle}}" bindinput="__e"/><input data-event-opts="{{[['input',[['updatePrice',['$event']]]]]}}" class="sectitle" value="{{'$'+newPrice}}" bindinput="__e"/><input data-event-opts="{{[['input',[['updateDesc',['$event']]]]]}}" class="des" value="{{newDesc}}" bindinput="__e"/><view class="flavCard"><input data-event-opts="{{[['input',[['updateCK',['$event']]]]]}}" class="flavCardL" value="{{newCustomKey}}" bindinput="__e"/><input data-event-opts="{{[['input',[['updateFlav',['$event']]]]]}}" class="flavCardR" value="{{newFlav}}" bindinput="__e"/></view><view class="section1"><picker value="{{index1}}" range="{{coll.array1}}" data-event-opts="{{[['change',[['bindPickerChange1',['$event']]]]]}}" bindchange="__e"><view class="picker">{{'SIZE：'+coll.array1[index1]+''}}</view></picker></view><view class="section2"><view class="kcMark">库存</view><input data-event-opts="{{[['input',[['updateKc',['$event']]]]]}}" class="picker" value="{{newKc}}" bindinput="__e"/></view><view class="atc"><button class="adtocart" hover-class="btn_hover" data-event-opts="{{[['tap',[['submitNew',['$event']]]]]}}" bindtap="__e">{{advic}}</button></view></view><block wx:if="{{imgPop}}"><scroll-view class="imageWindow" scroll-x><input class="imgInput" maxlength="-1" placeholder="输入图片链接，用分号隔开" data-event-opts="{{[['input',[['updateImg',['$event']]]]]}}" bindinput="__e"/><view data-event-opts="{{[['tap',[['parseNewImg',['$event']]]]]}}" class="leftBut" bindtap="__e">确定</view><view data-event-opts="{{[['tap',[['cancelImg',['$event']]]]]}}" class="rightBut" bindtap="__e">取消</view></scroll-view></block></view>