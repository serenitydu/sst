<view class="container"><scroll-view class="message_rec" scroll-y="true"><view class="blankArea"></view><block wx:for="{{msgs}}" wx:for-item="message" wx:for-index="index" wx:key="index"><block><block wx:if="{{userId!=message.open_Id}}"><view class="chatArea"><image class="msg_avt1" src="{{message.avt}}" mode="aspectFill"></image><text class="msgText">{{message.cnt}}</text></view></block><block wx:else><view class="chatArea"><text class="msgText2">{{message.cnt}}</text><image class="msg_avt2" src="{{message.avt}}" mode="aspectFill"></image></view></block><view class="timeB"><text class="msgDate">{{message.tsp}}</text></view></block></block></scroll-view><view class="message_send"><input class="inputArea" name="psw" placeholder="输入评论" data-event-opts="{{[['input',[['setpos',['$event']]]]]}}" value="{{commentInput}}" bindinput="__e"/><button data-event-opts="{{[['tap',[['sendMsg',['$event']]]]]}}" class="confirm_but" bindtap="__e">发送</button></view></view>