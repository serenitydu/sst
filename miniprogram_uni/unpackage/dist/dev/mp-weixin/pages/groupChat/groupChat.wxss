.container{
	height: 100%;
	width: 100vw;
}
.message_rec{
	height: 86vh;
	width: 100vw;
}
.message_send{
	width: 100%;
	height: 50px;
	opacity: 0.52;
}
.blankArea{
	height: 1vw;
	width: 100vw;
}
.confirm_but{
	background:#ffc000;
	color:white;
	position: absolute;
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	-webkit-box-orient: horizontal;
	-webkit-box-direction: normal;
	-webkit-flex-direction: row;
	        flex-direction: row;
	-webkit-box-pack: center;
	-webkit-justify-content: center;
	        justify-content: center;
	right: 10rpx;
	bottom: 10px;
	height: 30px;
	width: 150rpx;
	-webkit-box-align: center;
	-webkit-align-items: center;
	        align-items: center;
}
.inputArea{
	position: relative;
	height: 38px;
	top:6px;
	left: 2%;
	width: 75%;
	background:#ffffff;
	opacity: 1;
	border-radius: 5px;
}
.msgDate{
	display: -webkit-box;
	text-overflow: ellipsis; 
	word-wrap: break-word; 
	white-space: normal !important;
	-webkit-box-orient: vertical;
	font-size: 60%;
	color: #B8B8B8;
}
.msgText{
	display: -webkit-box;
	text-overflow: ellipsis; 
	word-wrap: break-word; 
	white-space: normal !important;
	-webkit-box-orient: vertical;
	background: gainsboro;
	border-radius: 15rpx;
	width: 80vw;
	margin-left: 14vw;
}
.msgText2{
	display: -webkit-box;
	text-overflow: ellipsis; 
	word-wrap: break-word; 
	white-space: normal !important;
	-webkit-box-orient: vertical;
	background: gainsboro;
	border-radius: 15rpx;
	width: 80vw;
	margin-left: 6vw;
}
.chatArea{
	width: 100vw;
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	min-height: 10vw;
}
.author_name{
	position: relative;
	left: 3vw;
	font-size: 120%;
	font-weight: 700;
	color: #94AFCE;
}
.msg_avt1{
	position: absolute;
	left: 1vw;
	height: 10vw;
	width: 10vw;
	border-radius: 100px;
}
.msg_avt2{
	position: absolute;
	right: 1vw;
	height: 10vw;
	width: 10vw;
	border-radius: 100px;
}
.timeB{
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	-webkit-box-pack: center;
	-webkit-justify-content: center;
	        justify-content: center;
	height: 4vh;
	width: 100vw;
	-webkit-box-align: start;
	-webkit-align-items: flex-start;
	        align-items: flex-start;
}

