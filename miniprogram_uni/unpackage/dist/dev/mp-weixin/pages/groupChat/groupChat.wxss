.container{
	height: 100%;
	width: 100vw;
}
.message_rec{
	height: 86vh;
	width: 100vw;
}
.message_send{
	width: 100%;
	height: 50px;
	background:rgb(228, 228, 228);
	opacity: 0.52;
}
.confirm_but{
	background:#ffc000;
	color:white;
	position: absolute;
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	-webkit-box-orient: horizontal;
	-webkit-box-direction: normal;
	-webkit-flex-direction: row;
	        flex-direction: row;
	-webkit-box-pack: center;
	-webkit-justify-content: center;
	        justify-content: center;
	right: 10rpx;
	bottom: 10px;
	height: 30px;
	width: 150rpx;
	-webkit-box-align: center;
	-webkit-align-items: center;
	        align-items: center;
}
.inputArea{
	position: relative;
	height: 38px;
	top:6px;
	left: 2%;
	width: 75%;
	background:#ffffff;
	opacity: 1;
	border-radius: 5px;
}
.chatBubble{
	width: 50%;
	position: relative;
	left:5vw;
}
.msgText{
	display: -webkit-box;
	text-overflow: ellipsis; 
	word-wrap: break-word; 
	white-space: normal !important;
	-webkit-box-orient: vertical;
	background: #ffc000;
	border-radius: 15rpx;
}
.blankSpace{
	height: 2vh;
}
.blankSpace2{
	height: 2vh;
}
.msg_avt{
	height: 10vw;
	width: 10vw;
	
	border-radius: 100%;
}
.author_cont{
	position: relative;
	left: 5vw;
	top:2vw;
	display: -webkit-box;
	display: -webkit-flex;
	display: flex;
	-webkit-box-orient: horizontal;
	-webkit-box-direction: normal;
	-webkit-flex-direction: row;
	        flex-direction: row;
	-webkit-box-pack: start;
	-webkit-justify-content: flex-start;
	        justify-content: flex-start;
}
.author_name{
	position: relative;
	left: 3vw;
	font-size: 120%;
	font-weight: 700;
	color: #94AFCE;
}

