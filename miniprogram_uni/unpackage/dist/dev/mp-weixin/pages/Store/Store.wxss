/* component/popup.wxss */
.wx-popup {
  position: absolute;
  left: 0;
  top: 0rpx;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, .5);
}
.popup-container {
  position: absolute;
  left: 50%;
  top: 45%;
 
  width: 80%;
  max-width: 600rpx;
  border: 2rpx solid #ccc;
  border-radius: 10rpx;
  -webkit-box-sizing: bordre-box;
          box-sizing: bordre-box;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%); 
  overflow: hidden;
  background: #fff;
}
.wx-popup-title {
  width: 100%;
  padding: 20rpx;
  text-align: center;
  font-size: 40rpx;
  border-bottom: 2rpx solid red;
}
.wx-popup-con {
  margin: 60rpx 10rpx;
  text-align: center;
}
.wx-popup-btn {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-justify-content: space-around;
          justify-content: space-around;
  margin-bottom: 40rpx;
}
.wx-popup-btn text {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  width: 30%;
  height: 88rpx;
  border: 2rpx solid #ccc;
  border-radius: 88rpx;
}

.we-slide:nth-child(1){
  background-color: whitesmoke
}
/*第二个界面背景色*/
.we-slide:nth-child(2){
  background-color: whitesmoke
}
::-webkit-scrollbar{
  width: 0;
  height: 0;
  opacity: 0
}
.loopads{
  position: absolute;
  top: 0px;
  left:0px;
}
.Cart{
  position: absolute;
