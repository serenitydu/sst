}
/*“二手交易”这几个按钮，按下去之后的颜色*/
.active{
    color:rgb(32, 57, 80);
    border-bottom: 8rpx solid rgb(0, 132, 255);
    background: #ffffff;
}
/*这两个先不要动，是控制最上面两行总体排版的*/
.rowSelector{
  position: absolute;
  top: 30%;
    width: 100%;
    border-bottom: 2rpx solid #ccc;
    text-align: center;
    height: 6%;
    line-height: 88rpx;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    -webkit-flex-flow: row;
            flex-flow: row;
    -webkit-box-pack: justify;
    -webkit-justify-content: space-between;
            justify-content: space-between;
}
