<view><view class="container"><view class="loopads" style="{{('width:'+loopadsWD+'px; height: '+loopadsHT+'px;')}}"><text class="LoopTxt">选择想要管理的店铺</text></view><scroll-view class="shopList" style="{{('height: '+shopHT+'px;')}}" scroll-y><block wx:for="{{shops}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><view class="shopCSS" data-shopId="{{item._id}}" data-kind="{{item.kind}}" data-event-opts="{{[['tap',[['clickonStore',['$event']]]]]}}" bindtap="__e"><image class="shopImg" mode="aspectFill" src="{{item.img}}"></image><text class="shopNM">{{item.title+"\n"}}</text><text class="shopCC">{{item.count+" Items"}}</text></view></block></block></scroll-view></view><image class="scanQRBut" src="http://cdn.onlinewebfonts.com/svg/img_170543.png" data-event-opts="{{[['tap',[['scanQRcode',['$event']]]]]}}" bindtap="__e"></image></view>