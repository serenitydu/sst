<view><view class="heading"></view><view class="container"><view class="adBc">afsafs</view><block wx:for="{{gList}}" wx:for-item="message" wx:for-index="index" wx:key="index"><block><block wx:if="{{index%2!=0}}"><view class="gcBlock2" data-naviParam="{{message.groupChatId}}" data-naviParam2="{{message.groupChatTitle}}" data-event-opts="{{[['tap',[['tapGC',['$event']]]]]}}" bindtap="__e"><view class="nameBlock"><view class="avtBlock"><image class="avt" src="{{message.authorImg}}" mode="aspectFill"></image></view><view class="infoBlock"><view class="authorName">{{message.author}}</view><view class="dateStr">{{message.date}}</view></view></view><view class="contentBlock"><image class="contentImg" src="{{message.img[0]}}" mode="aspectFill"></image><view class="descBlock">{{message.desc}}</view></view></view></block><block wx:else><view class="gcBlock" data-naviParam="{{message.groupChatId}}" data-naviParam2="{{message.groupChatTitle}}" data-event-opts="{{[['tap',[['tapGC',['$event']]]]]}}" bindtap="__e"><view class="nameBlock"><view class="avtBlock"><image class="avt" src="{{message.authorImg}}" mode="aspectFill"></image></view><view class="infoBlock"><view class="authorName">{{message.author}}</view><view class="dateStr">{{message.date}}</view></view></view><view class="contentBlock"><image class="contentImg" src="{{message.img[0]}}" mode="aspectFill"></image><view class="descBlock">{{message.desc}}</view></view></view></block></block></block></view></view>